@tool
extends RefCounted
## 根据轨名生成 [code]GDFrameAudioChannels[/code]（[code]GDFrame.audio.play_bgs[/code] 等）。


const AUDIO_CHANNELS_PATH: String = "res://gdframe_project/generated/audio_channels.gd"
const SERVICE_PATH: String = "res://addons/gdframe_stream_bus/stream_bus_service.gd"
const GENERATOR_PATH: String = "res://addons/gdframe_stream_bus/editor/audio_api_gen.gd"

const _RESERVED_SUFFIXES: PackedStringArray = ["bgm", "sfx", "ui_sfx"]


static func method_suffix(channel: String) -> String:
	return channel.to_lower()


static func is_reserved(channel: String) -> bool:
	return _RESERVED_SUFFIXES.has(method_suffix(channel))


static func reserved_channels(names: PackedStringArray) -> PackedStringArray:
	var out := PackedStringArray()
	for name: String in names:
		if is_reserved(name):
			out.append(name)
	return out


## 返回 [code]ok[/code]、[code]message[/code]、[code]content[/code]。轨名与核心方法冲突时不产出内容。
static func build(names: PackedStringArray) -> Dictionary:
	var blocked: PackedStringArray = reserved_channels(names)
	if not blocked.is_empty():
		return {
			"ok": false,
			"message": "轨名与核心方法冲突，未生成：%s" % ", ".join(blocked),
			"content": "",
		}
	return {
		"ok": true,
		"message": "已生成 GDFrame.audio.play_* → %s" % AUDIO_CHANNELS_PATH,
		"content": build_source(names),
	}


static func build_source(names: PackedStringArray) -> String:
	var lines: PackedStringArray = PackedStringArray()
	lines.append("## Auto-generated by GDFrame Stream Bus - do not edit manually.")
	lines.append("extends GDFrameAudioManager")
	lines.append("class_name GDFrameAudioChannels")
	lines.append("")
	lines.append("var _stream_bus: GDFrameStreamBusService")
	lines.append("")
	for raw: String in names:
		var suffix: String = method_suffix(raw)
		var lit: String = "&\"%s\"" % raw
		lines.append(
			"func play_%s(stream: AudioStream, loop: bool = true, from_position: float = 0.0) -> void:"
			% suffix
		)
		lines.append("\t_stream_bus.play(%s, stream, loop, from_position)" % lit)
		lines.append("")
		lines.append("func stop_%s() -> void:" % suffix)
		lines.append("\t_stream_bus.stop(%s)" % lit)
		lines.append("")
		lines.append("func is_%s_playing() -> bool:" % suffix)
		lines.append("\treturn _stream_bus.is_playing(%s)" % lit)
		lines.append("")
	return "\n".join(lines) + "\n"


static func write_content(content: String) -> Error:
	var dir_path: String = AUDIO_CHANNELS_PATH.get_base_dir()
	var dir_err: Error = DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(dir_path))
	if dir_err != OK and dir_err != ERR_ALREADY_EXISTS:
		return dir_err
	var file := FileAccess.open(AUDIO_CHANNELS_PATH, FileAccess.WRITE)
	if file == null:
		return FileAccess.get_open_error()
	file.store_string(content)
	return OK
